# Names only. Set real values in the Vercel project or your shell. Do not commit them.

# Standalone site: leave empty. Hub mount: /funding
# This is inlined at build time. Redeploy after changing it.
NEXT_PUBLIC_BASE_PATH=

# NextAuth uses this path as its route base. Include /api/auth.
# Standalone: https://installation-milestone-funding-tool.vercel.app
# Hub now:    https://seamless-hub-pi.vercel.app/funding/api/auth
# Hub later:  https://hub.seamlesshome.com/funding/api/auth
NEXTAUTH_URL=

# Same value on this project and on seamless-hub. Shared HMAC secret.
HUB_TRUST_SECRET=

# Existing database. Read by the app and by the migration script. Do not delete it.
DATABASE_URL=

# New Vercel Marketplace Neon URL. Used only by scripts/migrate-to-vercel-postgres.ts.
TARGET_DATABASE_URL=

# Optional. Full callback URL, including /funding when mounted through the hub.
# Defaults to NEXTAUTH_URL + /api/gdrive/callback.
GDRIVE_REDIRECT_URI=
